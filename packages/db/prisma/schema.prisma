datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Algorithm {
  SM2
  FSRS
}

enum ExerciseType {
  FILL_BLANK
  MULTIPLE_CHOICE
  SENTENCE_CONSTRUCTION
}

enum LLMProvider {
  OLLAMA
  GROQ
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String?
  passwordHash   String?         @map("password_hash")
  image          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  accounts       Account[]
  sessions       Session[]
  wordLists      WordList[]
  userWords      UserWord[]
  reviewAttempts ReviewAttempt[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model WordList {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  name        String
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WordListItem[]

  @@index([userId])
  @@map("word_lists")
}

model VocabularyWord {
  id            String         @id @default(uuid())
  word          String
  language      String         @default("en")
  meaning       String         @map("definition")
  example       String?
  partOfSpeech  String?        @map("part_of_speech")
  cefrLevel     String?        @map("cefr_level")
  frequency     Float?
  frequencyRank Int?           @map("frequency_rank")
  source        String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  listItems     WordListItem[]
  userWords     UserWord[]

  @@index([word])
  @@index([language])
  @@map("vocabulary_words")
}

model WordListItem {
  id               String         @id @default(uuid())
  wordListId       String         @map("word_list_id")
  vocabularyWordId String         @map("vocabulary_word_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  wordList         WordList       @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  vocabularyWord   VocabularyWord @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)

  @@unique([wordListId, vocabularyWordId])
  @@index([wordListId])
  @@index([vocabularyWordId])
  @@map("word_list_items")
}

model UserWord {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  vocabularyWordId String          @map("vocabulary_word_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyWord   VocabularyWord  @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)
  learningState    LearningState?
  reviewAttempts   ReviewAttempt[]

  @@unique([userId, vocabularyWordId])
  @@index([userId])
  @@index([vocabularyWordId])
  @@map("user_words")
}

model LearningState {
  id             String    @id @default(uuid())
  userWordId     String    @unique @map("user_word_id")
  algorithm      Algorithm @default(SM2)
  // SM2 fields
  repetitions    Int?      @default(0)
  interval       Float?    @default(0)
  easeFactor     Float?    @default(2.5) @map("ease_factor")
  // FSRS fields
  difficulty     Float?
  stability      Float?
  retrievability Float?
  // Scheduling dates
  lastReviewedAt DateTime? @map("last_reviewed_at")
  nextReviewAt   DateTime? @map("next_review_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  userWord       UserWord  @relation(fields: [userWordId], references: [id], onDelete: Cascade)

  @@index([userWordId])
  @@index([nextReviewAt])
  @@map("learning_states")
}

model ReviewAttempt {
  id                 String     @id @default(uuid())
  userId             String     @map("user_id")
  userWordId         String     @map("user_word_id")
  rating             Int
  correct            Boolean
  reviewedAt         DateTime   @default(now()) @map("reviewed_at")
  previousInterval   Float?     @map("previous_interval")
  newInterval        Float?     @map("new_interval")
  previousEaseFactor Float?     @map("previous_ease_factor")
  newEaseFactor      Float?     @map("new_ease_factor")
  createdAt          DateTime   @default(now()) @map("created_at")
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWord           UserWord   @relation(fields: [userWordId], references: [id], onDelete: Cascade)
  exercises          Exercise[]

  @@index([userId])
  @@index([reviewedAt])
  @@index([userWordId])
  @@map("review_attempts")
}

model Exercise {
  id              String        @id @default(uuid())
  reviewAttemptId String?       @map("review_attempt_id")
  type            ExerciseType
  question        String
  response        String?
  answer          String
  explanation     String?
  provider        LLMProvider
  model           String
  createdAt       DateTime      @default(now()) @map("created_at")
  reviewAttempt   ReviewAttempt? @relation(fields: [reviewAttemptId], references: [id], onDelete: SetNull)

  @@index([reviewAttemptId])
  @@map("exercises")
}
