datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  name            String?
  passwordHash    String?         @map("password_hash")
  image           String?
  timezone        String          @default("Asia/Kolkata")
  dailyGoal       Int             @default(10) @map("daily_goal")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts        Account[]
  sessions        Session[]
  wordLists       WordList[]
  userWords       UserWord[]
  reviewAttempts  ReviewAttempt[]
  dailyActivities DailyActivity[]
  xpEvents        XpEvent[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model WordList {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WordListItem[]

  @@index([userId])
  @@map("word_lists")
}

model VocabularyWord {
  id                 String         @id @default(uuid()) @db.Uuid
  word               String
  language           String         @default("en")
  meaning            String         @map("definition")
  example            String?
  synonyms           String[]       @default([])
  partOfSpeech       String?        @map("part_of_speech")
  cefrLevel          String?        @map("cefr_level")
  frequency          Float?
  frequencyRank      Int?           @map("frequency_rank")
  source             String?
  romanization       String?
  nativeDefinition   String?        @map("native_definition")
  gender             String?
  forms              String?
  exampleTranslation String?        @map("example_translation")
  topic              String?
  difficulty         String?
  pronunciationUrl   String?        @map("pronunciation_url")
  sourceUrl          String?        @map("source_url")
  license            String?
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  listItems          WordListItem[]
  userWords          UserWord[]

  @@index([word])
  @@index([language])
  @@index([topic])
  @@index([romanization])
  @@map("vocabulary_words")
}

model WordListItem {
  id               String         @id @default(uuid()) @db.Uuid
  wordListId       String         @map("word_list_id") @db.Uuid
  vocabularyWordId String         @map("vocabulary_word_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  wordList         WordList       @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  vocabularyWord   VocabularyWord @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)

  @@unique([wordListId, vocabularyWordId])
  @@index([wordListId])
  @@index([vocabularyWordId])
  @@map("word_list_items")
}

model UserWord {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  vocabularyWordId String          @map("vocabulary_word_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyWord   VocabularyWord  @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)
  learningState    LearningState?
  reviewAttempts   ReviewAttempt[]

  @@unique([userId, vocabularyWordId])
  @@index([userId])
  @@index([vocabularyWordId])
  @@map("user_words")
}

enum Algorithm {
  SM2
  FSRS
}

model LearningState {
  id             String    @id @default(uuid()) @db.Uuid
  userWordId     String    @unique @map("user_word_id") @db.Uuid
  algorithm      Algorithm @default(SM2)
  // SM2 fields
  repetitions    Int?      @default(0)
  interval       Float?    @default(0)
  easeFactor     Float?    @default(2.5) @map("ease_factor")
  // FSRS fields
  difficulty     Float?
  stability      Float?
  retrievability Float?
  // Scheduling dates
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz(6)
  nextReviewAt   DateTime? @map("next_review_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  userWord       UserWord  @relation(fields: [userWordId], references: [id], onDelete: Cascade)

  @@index([userWordId])
  @@index([nextReviewAt])
  @@map("learning_states")
}

model ReviewAttempt {
  id                 String     @id @default(uuid()) @db.Uuid
  userId             String     @map("user_id") @db.Uuid
  userWordId         String     @map("user_word_id") @db.Uuid
  rating             Int
  correct            Boolean
  reviewedAt         DateTime   @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  previousInterval   Float?     @map("previous_interval")
  newInterval        Float?     @map("new_interval")
  previousEaseFactor Float?     @map("previous_ease_factor")
  newEaseFactor      Float?     @map("new_ease_factor")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWord           UserWord   @relation(fields: [userWordId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reviewedAt])
  @@index([userWordId])
  @@map("review_attempts")
}

model Exercise {
  id              String   @id @default(uuid())
  reviewAttemptId String?  @map("review_attempt_id")
  type            String
  question        String
  response        String?
  answer          String
  explanation     String?
  provider        String
  model           String
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([reviewAttemptId])
  @@map("exercises")
}

model DailyActivity {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  activityDate         String    @map("activity_date")
  uniqueWordsReviewed  Int       @default(0) @map("unique_words_reviewed")
  dailyGoalCompletedAt DateTime? @map("daily_goal_completed_at") @db.Timestamptz(6)
  xpEarned             Int       @default(0) @map("xp_earned")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
  @@index([userId])
  @@index([activityDate])
  @@map("daily_activities")
}

model XpEvent {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  amount           Int
  reason           String
  idempotencyKey   String   @unique @map("idempotency_key")
  activityDate     String   @map("activity_date")
  vocabularyWordId String?  @map("vocabulary_word_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activityDate])
  @@map("xp_events")
}
