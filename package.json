{
  "name": "rosp-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @rosp/web dev",
    "build": "pnpm --filter @rosp/shared build && pnpm --filter @rosp/db build && pnpm --filter @rosp/web build",
    "lint": "pnpm --filter @rosp/web lint",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @rosp/db db:generate",
    "db:migrate": "pnpm --filter @rosp/db db:migrate",
    "db:push": "pnpm --filter @rosp/db db:push",
    "db:seed": "pnpm --filter @rosp/db db:seed",
    "db:studio": "pnpm --filter @rosp/db db:studio",
    "vocab:audit": "tsx scripts/vocabulary/audit_vocabulary.ts",
    "vocab:deduplicate": "tsx scripts/vocabulary/deduplicate_words.ts",
    "vocab:import-hindi-expanded": "tsx scripts/vocabulary/import_hindi_expanded.ts",
    "vocab:import-marathi-expanded": "tsx scripts/vocabulary/import_marathi_expanded.ts",
    "vocab:enrich": "tsx scripts/vocabulary/enrich_metadata.ts",
    "vocab:ingest": "tsx scripts/vocabulary/ingest.ts",
    "vocab:import-ngsl": "tsx scripts/vocabulary/import_ngsl.ts",
    "vocab:import-indic": "tsx scripts/vocabulary/import_indic_glossaries.ts",
    "vocab:import-hindi": "tsx scripts/vocabulary/import_hindi_dataset.ts",
    "db:seed-demo": "tsx scripts/seed_demo_account.ts",
    "test": "tsx --test tests/streak_xp_gamification.test.ts tests/multilingual_pronunciation_demo.test.ts tests/dictionary_and_pronunciation.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
